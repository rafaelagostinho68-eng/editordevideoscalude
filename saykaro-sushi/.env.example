# ── Banco de dados (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/saykaro?schema=public"

# ── Segredo da aplicação (obrigatório em produção) ────────────────────────────
# Usado para gerar HMAC de IPs (limite de tentativas) — gere com: openssl rand -hex 32
APP_SECRET="troque-por-um-valor-aleatorio-de-64-caracteres"

# ── URL pública do site (links, prévia no WhatsApp, sitemap) ──────────────────
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"

# ── Imagens enviadas pelo painel ──────────────────────────────────────────────
# Em produção aponte para um volume PERSISTENTE (ou migre para S3/R2 — ver docs/DEPLOY.md)
UPLOAD_DIR="./storage/uploads"

# ── Primeiro administrador (usado somente por: npm run admin:create) ──────────
# Defina no momento da criação e remova depois. A senha nunca fica no código.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# ── Pagamento online (FUTURO — não utilizado nesta versão) ────────────────────
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_WEBHOOK_SECRET=""
