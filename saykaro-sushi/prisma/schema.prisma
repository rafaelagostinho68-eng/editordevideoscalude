// Saykaro Sushi Delivery — modelo de dados.
// Regras gerais:
//  • Todo valor monetário é INTEIRO em centavos (nunca float).
//  • Pedidos guardam SNAPSHOT de nome/preço/opções (alterar o catálogo não muda pedidos antigos).
//  • Pedido, pagamento e provedor de pagamento são camadas separadas (ver docs/PAGAMENTOS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Configurações do restaurante (linha única, id = 1)
model RestaurantSettings {
  id                  Int          @id @default(1)
  name                String       @default("Saykaro Sushi")
  tagline             String       @default("Qualidade, frescor e sabor")
  description         String       @default("Culinária japonesa em delivery: sushi, sashimi, entradas e yakissoba.")
  logoPath            String? // arquivo em /media (null = logo tipográfica padrão)
  whatsappPrimary     String       @default("5521987267277") // somente dígitos, com DDI
  whatsappSecondary   String?      @default("5521990952390")
  instagram           String?      @default("saykaro.sushi.delivery") // usuário, sem @
  announcement        String? // aviso exibido no topo do cardápio
  timezone            String       @default("America/Sao_Paulo")
  statusMode          StatusMode   @default(AUTO)
  ordersPaused        Boolean      @default(false)
  pausedMessage       String?
  deliveryEnabled     Boolean      @default(true)
  pickupEnabled       Boolean      @default(true)
  checkoutMode        CheckoutMode @default(WHATSAPP)
  orderCounterStart   Int          @default(1) // não usado em runtime; documentação do primeiro número
  updatedAt           DateTime     @updatedAt
}

enum StatusMode {
  AUTO // segue os horários semanais (se não houver horários: "horário não informado")
  OPEN // aberto manualmente
  CLOSED // fechado manualmente
}

enum CheckoutMode {
  WHATSAPP // modo atual
  ONLINE // modo futuro (pagamento no checkout) — ainda não implementado
}

model OpeningHour {
  id       Int     @id @default(autoincrement())
  weekday  Int // 0 = domingo … 6 = sábado
  opensAt  String // "HH:MM"
  closesAt String // "HH:MM" (se menor que opensAt, fecha após a meia-noite)
  enabled  Boolean @default(true)

  @@unique([weekday])
}

model PaymentMethod {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  label        String
  instructions String?
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  orders       Order[]
}

model DeliveryZone {
  id        Int      @id @default(autoincrement())
  name      String   @unique // bairro / região
  feeCents  Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
}

// ───────────────────────── Administração
model AdminUser {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String
  passwordHash String
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  statusEvents OrderStatusEvent[]
}

model AdminSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique // SHA-256 do token do cookie (o token em si nunca é salvo)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  ipHash    String?
  userAgent String?
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String // HMAC(ip) ou HMAC(ip + email)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model RateLimitHit {
  id        Int      @id @default(autoincrement())
  bucket    String // ex.: "order:create"
  key       String // HMAC do IP
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
}

// ───────────────────────── Catálogo
model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          Int                    @id @default(autoincrement())
  categoryId  Int
  name        String
  slug        String                 @unique
  description String?
  portion     String? // "10 peças", "4 unidades"…
  priceCents  Int
  active      Boolean                @default(true) // false = oculto do cardápio
  soldOut     Boolean                @default(false) // true = aparece, mas indisponível
  featured    Boolean                @default(false)
  isNew       Boolean                @default(false)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  category    Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  modifiers   ProductModifierGroup[]
  orderItems  OrderItem[]

  @@index([categoryId, sortOrder])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  path      String // arquivo principal em /media
  thumbPath String // miniatura em /media
  width     Int
  height    Int
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ModifierGroup {
  id          Int                    @id @default(autoincrement())
  name        String
  description String?
  required    Boolean                @default(false)
  minSelect   Int                    @default(0)
  maxSelect   Int                    @default(1)
  active      Boolean                @default(true)
  sortOrder   Int                    @default(0)
  options     ModifierOption[]
  products    ProductModifierGroup[]
}

model ModifierOption {
  id         Int           @id @default(autoincrement())
  groupId    Int
  name       String
  priceCents Int           @default(0)
  active     Boolean       @default(true)
  sortOrder  Int           @default(0)
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model ProductModifierGroup {
  productId Int
  groupId   Int
  sortOrder Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

// Itens do material original que ainda precisam de confirmação (NÃO publicados no cardápio).
model CatalogPending {
  id        Int      @id @default(autoincrement())
  title     String
  details   String
  source    String? // arquivo/trecho de origem
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ───────────────────────── Pedidos
enum OrderStatus {
  AWAITING_WHATSAPP // registrado; o cliente ainda não confirmou o envio
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

model Order {
  id                Int             @id @default(autoincrement())
  number            Int             @unique @default(autoincrement()) // SK000123
  publicToken       String          @unique // link do cliente (/pedido/<token>)
  idempotencyKey    String          @unique // evita pedidos duplicados em novo clique/reenvio
  status            OrderStatus     @default(AWAITING_WHATSAPP)
  customerName      String
  customerPhone     String
  fulfillment       Fulfillment
  street            String?
  streetNumber      String?
  complement        String?
  neighborhood      String?
  reference         String?
  notes             String?
  paymentMethodId   Int?
  paymentLabel      String // snapshot
  subtotalCents     Int
  deliveryFeeCents  Int? // null = a confirmar pelo restaurante
  totalCents        Int // produtos + taxa (quando conhecida)
  whatsappTarget    String // número usado na mensagem
  whatsappOpenedAt  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  events            OrderStatusEvent[]
  payments          PaymentRecord[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id             Int               @id @default(autoincrement())
  orderId        Int
  productId      Int? // nulo se o produto for excluído depois
  productName    String // snapshot
  portion        String? // snapshot
  unitPriceCents Int // snapshot (preço base)
  optionsCents   Int               @default(0) // soma dos adicionais por unidade
  quantity       Int
  lineTotalCents Int
  notes          String?
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  options        OrderItemOption[]
}

model OrderItemOption {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  groupName   String // snapshot
  optionName  String // snapshot
  priceCents  Int // snapshot
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderStatusEvent {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  adminId   Int?
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin     AdminUser?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// Camada de pagamento (ainda sem gateway). Cada tentativa de cobrança futura vira um registro.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model PaymentRecord {
  id          Int           @id @default(autoincrement())
  orderId     Int
  provider    String // "mercadopago", "pix-manual"…
  method      String? // "pix", "credit_card"…
  status      PaymentStatus @default(PENDING)
  amountCents Int
  externalId  String? // id no gateway
  payload     Json? // resposta/webhook bruto do gateway
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@unique([provider, externalId])
}
